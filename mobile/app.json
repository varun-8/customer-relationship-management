{
  "expo": {
    "name": "Vasantham CRM",
    "slug": "vasantham-crm",
    "scheme": "vasanthamcrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vasantham.crm"
    },
    "android": {
      "package": "com.vasantham.crm",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "fbff3ac0-94e2-4072-b59e-abbbc942f0f9"
      }
    }
  }
}
