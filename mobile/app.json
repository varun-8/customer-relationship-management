{
  "expo": {
    "name": "Vasantham CRM",
    "slug": "vasantham-crm",
    "scheme": "vasanthamcrm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vasantham.crm",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.vasantham.crm",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "87e4751f-f72f-4a8e-a0bc-e0cedc72354b"
      }
    },
    "owner": "varuunnnnn",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vasantham CRM to access camera to scan Desktop pairing QR code."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
