{
  "name": "vasantham-crm-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "update-ip": "node ../scripts/update-ip.js",
    "dev": "node ../scripts/update-ip.js && node start-desktop.js",
    "dev:browser": "node ../scripts/update-ip.js && concurrently -k -n \"BACKEND,DESKTOP\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm --prefix ../backend run dev\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:electron": "electron .",
    "build": "node ../scripts/update-ip.js && vite build",
    "build:testing": "vite build --mode testing",
    "dev:testing": "vite --mode testing",
    "dist:exe": "node ../scripts/update-ip.js && vite build && electron-builder --win",
    "build:exe": "npm run dist:exe",
    "dist:testing-exe": "vite build --mode testing && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "install": "^0.13.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.383.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.vasantham.crm.desktop",
    "productName": "Vasantham CRM",
    "copyright": "Copyright © 2026 Vasantham Tiles & Sanitary Wares",
    "directories": {
      "output": "dist-exe"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vasantham CRM",
      "uninstallDisplayName": "Vasantham CRM"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "src/**/*",
          "node_modules/**/*",
          "bin/**/*",
          "package.json",
          ".env",
          ".env.example"
        ]
      },
      {
        "from": "../backend/bin",
        "to": "mongodb",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
