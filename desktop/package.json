{
  "name": "vasantham-crm-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node start-desktop.js",
    "dev:browser": "concurrently -k -n \"BACKEND,DESKTOP\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm --prefix ../backend run dev\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:electron": "electron .",
    "dev:tauri": "concurrently -k -n \"BACKEND,TAURI\" -c \"bgBlue.bold,bgCyan.bold\" \"npm --prefix ../backend run dev\" \"tauri dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0-rc.0",
    "@tauri-apps/cli": "^2.0.0-rc.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "vite": "^5.2.11"
  }
}
