{
  "name": "vasantham-crm-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node start-desktop.js",
    "dev:browser": "concurrently -k -n \"BACKEND,DESKTOP\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm --prefix ../backend run dev\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:electron": "electron .",
    "build": "vite build",
    "build:exe": "node ../scripts/setup-bundled-mongodb.js && vite build && electron-builder --win",
    "dist:exe": "node ../scripts/setup-bundled-mongodb.js && vite build && electron-builder --win",
    "setup:mongo": "node ../scripts/setup-bundled-mongodb.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.383.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.vasantham.crm.desktop",
    "productName": "Vasantham CRM",
    "copyright": "Copyright © 2026 Vasantham Tiles & Sanitary Wares",
    "directories": {
      "output": "dist-exe"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vasantham CRM",
      "uninstallDisplayName": "Vasantham CRM",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../backend/**/*",
      "../scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/bin/mongodb",
        "to": "mongodb"
      }
    ]
  }
}
