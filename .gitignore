# =============================================================================
# Root .gitignore for Vasantham / BuildCRM (Backend, Desktop, Mobile)
# =============================================================================

# Dependencies
node_modules/
backend/node_modules/
desktop/node_modules/
mobile/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
desktop/.env
mobile/.env

# Production & Build Outputs (Build outputs included as requested)
!desktop/dist-exe/
!desktop/dist-exe/**
!backend/bin/
!backend/bin/**
!*.exe
!*.apk
backend/bin/*.zip
backend/bin/temp_extract/
backend/data/

# Expo / React Native & Android Native Builds
.expo/
.expo-shared/
.expo-export-check/
mobile/.expo/
mobile/.expo-export-check/
mobile/dist/
mobile/dist-*/
mobile/web-build/
mobile/android/.cxx/
mobile/android/app/.cxx/
mobile/android/.kotlin/
mobile/android/app/.kotlin/
mobile/android/.gradle/
mobile/android/app/src/main/assets/index.android.bundle
*.aab
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Archives & Bundle Dumps
*.tar.gz
*.zip
*.7z
*.rar

# Temporary & Scratch Files
.temp/
tmp/
scratch/
.gemini/
