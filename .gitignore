# =============================================================================
# Root .gitignore for Vasantham / BuildCRM (Backend, Desktop, Mobile)
# =============================================================================

# Dependencies
node_modules/
backend/node_modules/
desktop/node_modules/
mobile/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
desktop/.env
mobile/.env

# Production & Build Outputs
dist/
desktop/dist/
desktop/dist-exe/
build/
desktop/build/
backend/bin/
out/
web-build/
desktop/src-tauri/target/
src-tauri/target/

# Expo / React Native & Android Native Builds
.expo/
.expo-shared/
.expo-export-check/
mobile/.expo/
mobile/.expo-export-check/
mobile/android/.cxx/
mobile/android/app/.cxx/
mobile/android/.kotlin/
mobile/android/app/.kotlin/
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/app/src/main/assets/index.android.bundle
*.apk
*.aab
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# OS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary & AI Scratch Files
.temp/
tmp/
scratch/
.gemini/
